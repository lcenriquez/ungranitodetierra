---
const navItems = [
  { href: '/', text: 'Inicio' },
  { href: '/arboricultura', text: 'Arboricultura' },
  { href: '/productos-servicios', text: 'Productos y Servicios' },
  // { href: '/alianzas', text: 'Alianzas' },
  { href: '/contacto', text: 'Contacto' },
  // { href: '/dona', text: 'Dona' },
];

const currentPath = Astro.url.pathname;
---

<nav class="bg-white/95 backdrop-blur border-b border-pale-stone py-4 sticky top-0 z-40">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center">
      <a href="/" class="flex items-center gap-3 text-lg font-medium text-brand-brown">
        <img src="/favicon.svg" alt="" class="h-9 w-9" width="36" height="36" aria-hidden="true" />
        <span>Un Granito de Tierra</span>
      </a>

      <!-- Hamburger button -->
      <button
        id="menu-toggle"
        class="md:hidden flex flex-col justify-center items-center w-10 h-10 space-y-1.5 cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="w-6 h-0.5 bg-brand-brown transform transition duration-300 ease-in-out"></span>
        <span class="w-6 h-0.5 bg-brand-brown transform transition duration-300 ease-in-out"></span>
        <span class="w-6 h-0.5 bg-brand-brown transform transition duration-300 ease-in-out"></span>
      </button>

      <!-- Desktop menu -->
      <div class="hidden md:flex gap-8">
        {navItems.map(item => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
            class:list={[
              'transition-colors font-medium text-sm pb-1 border-b-2',
              currentPath === item.href
                ? 'text-brand-green border-brand-green'
                : 'text-brand-brown border-transparent hover:text-brand-green hover:border-light-sage',
            ]}
          >
            {item.text}
          </a>
        ))}
      </div>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 transition-all duration-300 ease-in-out"
    >
      <div class="flex flex-col space-y-4 py-3">
        {navItems.map(item => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? 'page' : undefined}
            class:list={[
              'transition-colors mobile-menu-item font-medium',
              currentPath === item.href ? 'text-brand-green' : 'text-brand-brown hover:text-brand-green',
            ]}
          >
            {item.text}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  function setupMobileMenu() {
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuItems = document.querySelectorAll('.mobile-menu-item');
    const menuBars = menuToggle?.querySelectorAll('span');
    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      
      // Toggle menu visibility
      mobileMenu?.classList.toggle('hidden');
      menuToggle?.setAttribute('aria-expanded', String(isOpen));

      // Animate hamburger icon
      if (menuBars && menuBars.length === 3) {
        if (isOpen) {
          menuBars[0].classList.add('rotate-45', 'translate-y-2');
          menuBars[1].classList.add('opacity-0');
          menuBars[2].classList.add('-rotate-45', '-translate-y-2');
        } else {
          menuBars[0].classList.remove('rotate-45', 'translate-y-2');
          menuBars[1].classList.remove('opacity-0');
          menuBars[2].classList.remove('-rotate-45', '-translate-y-2');
        }
      }
    }

    // Toggle menu on button click
    menuToggle?.addEventListener('click', toggleMenu);

    // Close menu when clicking a menu item
    menuItems.forEach(item => {
      item.addEventListener('click', () => {
        if (isOpen) {
          toggleMenu();
        }
      });
    });

    // Close menu on window resize if open
    window.addEventListener('resize', () => {
      if (isOpen && window.innerWidth >= 768) {
        toggleMenu();
      }
    });
  }

  // Initialize menu functionality
  setupMobileMenu();

  // Re-initialize when navigating between pages
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>